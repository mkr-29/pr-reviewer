# ==============================================================================
# Mattermost PR/MR Automated Reviewer - Environment Configuration
# ==============================================================================

# --- Mattermost Configuration ---
# Base URL of your Mattermost server (without trailing slash)
MM_URL=https://mattermost.yourco.com

# Mattermost Personal Access Token (PAT) or Bot Access Token
MM_TOKEN=your_mattermost_access_token_here

# Channel to scan for task update posts
MM_CHANNEL_NAME=Daily Task Update

# Optional: Exact channel ID (skips team/channel name search if specified)
# MM_CHANNEL_ID=d5brag66tpyrijadap8w8crfoe

# Username whose mentions to monitor (supports comma-separated usernames, e.g. mayank.kumar,mayank.kumar1)
MM_TARGET_USERNAME=mayank.kumar,mayank.kumar1

# --- Branch Gate & Repo Filtering ---
# Required target branch for all pull/merge requests
TARGET_BRANCH=pre-main

# Repository filter (e.g. 'backend' to only process backend MRs/PRs)
REPO_FILTER=backend

# --- Schedule & Timing ---
# Polling interval in hours (e.g. 1 for every 1 hour)
POLL_INTERVAL_HOURS=1

# Everyday execution time in 24h format (e.g. 20:00 for 8:00 PM)
SCHEDULE_TIME=20:00

# Timezone for the daily schedule (e.g. Asia/Kolkata, UTC, America/New_York)
SCHEDULE_TIMEZONE=Asia/Kolkata

# Lookback window for first run in hours
LOOKBACK_HOURS=24

# Path to persistent state file (mounted into ./data inside Docker)
STATE_FILE=data/state.json

# --- Git Providers ---
# GitLab host URL (default: https://gitlab.com or your internal instance)
GITLAB_URL=https://gitlab.yourco.com

# GitLab Personal Access Token with 'read_api' scope
GITLAB_TOKEN=your_gitlab_token_here

# GitHub Personal Access Token with 'repo' scope (if reviewing GitHub PRs)
GITHUB_TOKEN=your_github_token_here

# --- LLM Review Engine & Multi-Provider Fallback ---
# Preferred provider: 'auto', 'gemini', 'groq', 'azure', 'inception', 'anthropic', or 'openai'
LLM_PROVIDER=auto

# Provider 1: Google Gemini API (Recommended for fast, detailed reviews)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Provider 2: Groq API (High-speed inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Provider 3: Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-5.5
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Provider 4: Inception Labs API
INCEPTION_API_KEY=your_inception_key_here
INCEPTION_MODEL=mercury-2

# Provider 5: Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Provider 6: Cursor / OpenAI compatible endpoint
OPENAI_API_KEY=your_openai_or_cursor_key_here
# OPENAI_BASE_URL=https://api.cursor.sh/v1
OPENAI_MODEL=gpt-4o
