# ==============================================================================
# Git Ignore Rules for PR Reviewer (Python + Docker)
# ==============================================================================

# Environment variables & secrets (CRITICAL: Never commit these)
.env
.env.*
!.env.example
.mm_bot_env

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Persistent state & logs
data/
*.log
.mm_mr_review_state.json

# Operating System & IDE files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Node / JS artifacts (if any)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
